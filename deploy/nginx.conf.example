# FISI-HQ – Beispiel-Konfiguration fuer nginx (Gegenstueck zur .htaccess)
# Einbinden im server{}-Block von example.org, danach: nginx -t && systemctl reload nginx
# root/server_name an die bestehende Konfiguration anpassen.

    index index.html;
    charset utf-8;
    server_tokens off;
    gzip_static on;          # liefert vorhandene *.gz direkt aus

    # Echte 404 statt Startseite (kein try_files ... /index.html Fallback!)
    error_page 404 /404.html;
    location = /404.html { internal; }

    # Versteckte Dateien sperren (.htaccess, .git, .env …), .well-known erlauben
    location ^~ /.well-known/ { try_files $uri =404; }
    location ~ /\. { deny all; return 404; }

    # Nur lesende Methoden
    if ($request_method !~ ^(GET|HEAD|OPTIONS)$) { return 405; }

    # Sicherheits-Header (entspricht der bisherigen .htaccess)
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), fullscreen=(self)" always;
    add_header Cross-Origin-Opener-Policy "same-origin" always;
    add_header Cross-Origin-Resource-Policy "same-origin" always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    # 'self' deckt auch das Cloudflare-Bot-Skript unter /cdn-cgi/ ab
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://upload.wikimedia.org https://commons.wikimedia.org; connect-src 'self' https://commons.wikimedia.org; font-src 'self'; object-src 'none'; frame-src https://www.youtube-nocookie.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests" always;

    location / { try_files $uri $uri/ =404; }

    # Caching – wichtig, damit Korrekturen ankommen
    # Hinweis: add_header in einem location-Block ersetzt die Header von oben,
    # daher hier per include wiederholen ODER die Header in eine Datei auslagern
    # (z. B. /etc/nginx/snippets/fisi-security.conf) und überall includen.
    location = /sw.js {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/fisi-security.conf;
        try_files $uri =404;
    }
    location ~* \.html$ {
        add_header Cache-Control "no-cache" always;
        include /etc/nginx/snippets/fisi-security.conf;
        try_files $uri =404;
    }
    location ~* \.(css|js|webmanifest|svg)$ {
        add_header Cache-Control "public, max-age=604800" always;    # 7 Tage
        include /etc/nginx/snippets/fisi-security.conf;
        try_files $uri =404;
    }
    location ~* \.woff2$ {
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        include /etc/nginx/snippets/fisi-security.conf;
        try_files $uri =404;
    }

# --- /etc/nginx/snippets/fisi-security.conf: die sieben add_header-Zeilen
#     der Sicherheits-Header von oben hineinkopieren.

# --- Cloudflare (Dashboard) ---
# 1. Caching → Cache Rules: für /sw.js "Bypass cache" ODER "Respect origin" (Edge TTL nicht 1 Jahr)
# 2. Nach jedem Deploy: Caching → Configuration → Purge Everything
# 3. Optional: Scrape Shield → Email Address Obfuscation darf an bleiben
